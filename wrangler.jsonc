// Configuration of the ci-cache Worker. Secrets (SESSION_SECRET, SANDBOX_KEYS, ...)
// don't go here: load them with `wrangler secret put` (see the README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ci-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // Bucket with the weur location hint: Boat's runners and sandboxes are at OVH in France
  // and Poland. The first one (`ci-cache`, no hint) landed in WNAM and every R2 read took
  // ~180 ms from Europe. The hint can only be given when the bucket is created.
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "ci-cache-weur" }],
  // Must match METRICS_DATASET (the /v1/stats queries use that name).
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "ci_cache" }],
  "vars": {
    // Audience that GitHub Actions OIDC tokens must carry.
    "CACHE_AUDIENCE": "ci-cache",
    // Owners (GitHub users or organizations) whose repos may use the cache.
    "ALLOWED_OWNERS": "OmarAlex24",
    // Events that, on a MAIN_REFS ref, write to main/.
    "MAIN_WRITE_EVENTS": "push",
    "MAIN_REFS": "refs/heads/main,refs/heads/master",
    // Session token lifetime, in seconds (6 h).
    "SESSION_TTL_SECONDS": "21600",
    // Per-object cap on PUT (100 MB, a Worker's request body limit).
    "MAX_ARTIFACT_BYTES": "104857600",
    "METRICS_DATASET": "ci_cache",
    // /v1/stats/branches flags reuseAlert if the sandbox wrote at least this many and CI hit none.
    "REUSE_ALERT_MIN_WRITES": "20"
  }
}
