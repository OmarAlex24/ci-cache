{
  "name": "ci-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test scripts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "cf-typegen": "wrangler types --include-env=false",
    "e2e:turbo": "node scripts/e2e/turbo.mjs",
    "e2e:sccache": "node scripts/e2e/sccache.mjs",
    "e2e": "pnpm e2e:turbo && pnpm e2e:sccache && pnpm e2e:sandbox && pnpm e2e:setup",
    "lint:openapi": "pnpm --package=@redocly/cli@2.65.0 dlx redocly lint openapi.yaml",
    "e2e:sandbox": "node scripts/e2e/sandbox-env.mjs",
    "e2e:setup": "node scripts/e2e/setup-action.mjs",
    "lint:sh": "shellcheck setup/setup.sh scripts/ci-cache-env.sh && shellcheck -e SC1091 scripts/cache-fingerprint.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "hono": "4.13.16",
    "jose": "6.2.15"
  }
}
