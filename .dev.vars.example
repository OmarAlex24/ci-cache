# Copy this file to .dev.vars for `wrangler dev`. Never commit .dev.vars.
SESSION_SECRET=replace-this-with-at-least-32-random-characters
# JSON: sha256(key) -> {repoId, repo, label}. Generate keys with `node scripts/new-key.mjs sandbox`.
SANDBOX_KEYS={}
# JSON: sha256(key) -> {label, repoIds?}. Generate with `node scripts/new-key.mjs stats <label>`.
STATS_KEYS={}
# Only for /v1/stats against the real Analytics Engine (there is no local AE).
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
